CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_CPU_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_S3C2410_WATCHDOG=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_SYSCON_REBOOT_MODE=y

# Storage, USB and Type-C
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_DWC_TC_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MAXIM=m
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_EXYNOS_PCIE=y

# Display and GPU
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
# CONFIG_DRM_EXYNOS5433_DECON is not set
# CONFIG_DRM_EXYNOS7_DECON is not set
CONFIG_DRM_EXYNOS9_DECON=y
# CONFIG_DRM_EXYNOS9_DP is not set
CONFIG_DRM_PANEL_GOOGLE_HK3=y
CONFIG_DRM_PANTHOR=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# Touch, haptics and sensors
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_FTM5_SPI=y
CONFIG_TOUCHSCREEN_TBN_OPS=y
CONFIG_TOUCHSCREEN_TBN=m
CONFIG_INPUT_MISC=y
CONFIG_CL_DSP=y
CONFIG_INPUT_CS40L26=y
CONFIG_INPUT_AOC_GESTURE_WAKE=m
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_STK3310=y

# Wi-Fi, Bluetooth, GNSS and modem
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_BCMDHD_BCM4390=y
CONFIG_BCMDHD_BCM4390_FOR_BCM4398=y
CONFIG_BCMDHD_BCM4390_VENDOR_FW_NAMES=y
CONFIG_BT=y
CONFIG_RFKILL=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIAOC=m
CONFIG_GNSS=y
CONFIG_WWAN=y
CONFIG_S5300_MODEM=m
CONFIG_S5XXX_RFS_SESSION=m

# Audio and coprocessors
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_CS35L41_SPI=m
CONFIG_SND_SOC_GOOGLE_AOC=m
CONFIG_REMOTEPROC=y
CONFIG_TRUSTY=y
CONFIG_GOOGLE_AOC=m
CONFIG_GOOGLE_AOC_CHANNEL=m
CONFIG_GOOGLE_AOC_USF=m
CONFIG_AOC_USF_IIO=m

# Firmware handover and identity storage
CONFIG_NVMEM=y
CONFIG_NVMEM_MAX77759=y
CONFIG_NVMEM_RMEM=y

# Carried from the validated Husky 7.3 configuration: options the phone image
# relies on that arm64 defconfig leaves off or modular (SELinux and its
