# Google Tensor G3 (zuma) and Pixel 8 Pro (husky)
CONFIG_ARCH_EXYNOS=y
CONFIG_LUMA_EMBEDDED_DTB_HANDOFF=y
CONFIG_LUMA_EMBEDDED_DTB="exynos/google/zuma-husky"

# Clocks, power domains, interrupts and interconnects
CONFIG_EXYNOS_ACPM_CLK=y
CONFIG_EXYNOS_ACPM_PROTOCOL=y
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_SLC=y
CONFIG_EXYNOS_S2MPU=y
CONFIG_EXYNOS_GSA=y
CONFIG_EXYNOS_CP_POWER=y
CONFIG_GOOGLE_VGPIO2AP_IRQ=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_SAMSUNG=y
CONFIG_ARM_EXYNOS_BUS_DEVFREQ=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_TOUCH_BOOST=m
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y

# Bus controllers, pin control and GPIO
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_I2C=y
CONFIG_I2C_S3C2410=y
CONFIG_SPI=y
CONFIG_SPI_S3C64XX=y
CONFIG_SPMI=y
CONFIG_PINCTRL_SAMSUNG=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_GPIO_S2MPG1X=m
CONFIG_GPIO_MAX77759=y
CONFIG_HWSPINLOCK=y
CONFIG_MAILBOX=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_EXYNOS=y

# PMICs, charging, battery and thermal control
CONFIG_MFD_SEC_ACPM=y
CONFIG_MFD_SEC_I2C=y
CONFIG_MFD_MAX77759=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_S2MPA01=y
CONFIG_REGULATOR_S2MPS11=y
CONFIG_REGULATOR_SLG51000=m
CONFIG_S2MPG1415_METER=y
CONFIG_BATTERY_MAX17042=y
CONFIG_BATTERY_SAMSUNG_SDI=y
CONFIG_CHARGER_MAX77759=m
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_CPU_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_S3C2410_WATCHDOG=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_SYSCON_REBOOT_MODE=y

# Storage, USB and Type-C
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_DWC_TC_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MAXIM=m
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_EXYNOS_PCIE=y

# Display and GPU
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
# CONFIG_DRM_EXYNOS5433_DECON is not set
# CONFIG_DRM_EXYNOS7_DECON is not set
CONFIG_DRM_EXYNOS9_DECON=y
# CONFIG_DRM_EXYNOS9_DP is not set
CONFIG_DRM_PANEL_GOOGLE_HK3=y
CONFIG_DRM_PANTHOR=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# Touch, haptics and sensors
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_FTM5_SPI=y
CONFIG_TOUCHSCREEN_TBN_OPS=y
CONFIG_TOUCHSCREEN_TBN=m
CONFIG_INPUT_MISC=y
CONFIG_CL_DSP=y
CONFIG_INPUT_CS40L26=y
CONFIG_INPUT_AOC_GESTURE_WAKE=m
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_STK3310=y

# Wi-Fi, Bluetooth, GNSS and modem
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_BCMDHD_BCM4390=y
CONFIG_BCMDHD_BCM4390_FOR_BCM4398=y
CONFIG_BCMDHD_BCM4390_VENDOR_FW_NAMES=y
CONFIG_BT=y
CONFIG_RFKILL=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIAOC=m
CONFIG_GNSS=y
CONFIG_WWAN=y
CONFIG_S5300_MODEM=m
CONFIG_S5XXX_RFS_SESSION=m

# Audio and coprocessors
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_CS35L41_SPI=m
CONFIG_SND_SOC_GOOGLE_AOC=m
CONFIG_REMOTEPROC=y
CONFIG_TRUSTY=y
CONFIG_GOOGLE_AOC=m
CONFIG_GOOGLE_AOC_CHANNEL=m
CONFIG_GOOGLE_AOC_USF=m
CONFIG_AOC_USF_IIO=m

# Firmware handover and identity storage
CONFIG_NVMEM=y
CONFIG_NVMEM_MAX77759=y
CONFIG_NVMEM_RMEM=y
