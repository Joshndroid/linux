config INTERCONNECT_SAMSUNG
	bool "Samsung SoC interconnect drivers"
	depends on ARCH_EXYNOS || COMPILE_TEST
	help
	  Interconnect drivers for Samsung SoCs.

config INTERCONNECT_EXYNOS
	tristate "Exynos SoC generic interconnect driver"
	depends on INTERCONNECT_SAMSUNG
	default y if ARCH_EXYNOS
	help
	  Generic interconnect driver for Samsung Exynos SoCs (e.g. Exynos3250,
	  Exynos4210, Exynos4412, Exynos542x, Exynos5433).
	  Choose Y here only if you build for such Samsung SoC.

config INTERCONNECT_EXYNOS_BTS
	tristate "Exynos Bus Traffic Shaper interconnect driver"
	depends on INTERCONNECT_SAMSUNG
	depends on COMMON_CLK
	help
	  Interconnect provider for the Samsung Bus Traffic Shaper found in
	  Google Tensor SoCs. It programs per-master AXI quality of service and
	  converts aggregate bandwidth constraints into ACPM DVFS clock floors.

config INTERCONNECT_ZUMA
	tristate "Google Tensor G3 (zuma) memory interconnect driver"
	depends on INTERCONNECT_SAMSUNG
	depends on ARM_EXYNOS_BUS_DEVFREQ
	help
	  Interconnect provider for the memory (MIF) and CPU cluster
	  interconnect (DSU) buses of the Google Tensor G3. It aggregates the
	  CPU and GPU bandwidth votes and passes them to the buses' devfreq
	  devices as minimum frequencies.
